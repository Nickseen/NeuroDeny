---
layout: base.njk
pageType: article
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": "{{ page.url | absoluteUrl(settings.site.url) }}#article",
  "mainEntityOfPage": "{{ page.url | absoluteUrl(settings.site.url) }}",
  "headline": {{ title | json | safe }},
  "description": {{ description | json | safe }},
  "image": "{{ image | absoluteUrl(settings.site.url) }}",
  "datePublished": "{{ date | htmlDateString }}",
  "dateModified": "{{ date | htmlDateString }}",
  "author": {
    "@type": "Person",
    "name": {{ author | json | safe }}
  },
  "publisher": {
    "@id": "{{ settings.site.url }}#clinic"
  },
  "inLanguage": "ru",
  "about": ["неврология", "нейропедиатрия", "Комрат", "Молдова"]
}
</script>

<article class="blog-post container" style="max-width: 900px; margin: 100px auto 50px; padding: 20px;">
    <header class="post-header" style="margin-bottom: 2rem; border-bottom: 2px solid #e0e0e0; padding-bottom: 1.5rem;">
        <h1 style="font-size: 2.5rem; color: var(--primary-color); margin-bottom: 1rem;">{{ title }}</h1>
        <div class="post-meta" style="color: #666; font-size: 0.95rem;">
            <time datetime="{{ date }}">{{ date | dateFormat }}</time>
            {% if author %} • <span>{{ author }}</span>{% endif %}
        </div>
    </header>
    
    {% if image %}
    <div class="post-image" style="margin-bottom: 2rem;">
        <img src="{{ image | url }}" alt="{{ title }}" style="width: 100%; border-radius: 8px;">
    </div>
    {% endif %}
    
    <div class="post-content" style="font-size: 1.1rem; line-height: 1.8; color: #333;">
        {{ content | safe }}
    </div>
    
    <footer class="post-footer" style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #e0e0e0;">
        <a href="{{ '/#home' | url }}" class="back-link" style="color: var(--primary-color); text-decoration: none;">← Вернуться на главную</a>
    </footer>
</article>
