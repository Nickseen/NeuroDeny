{% set pageTitle = title or settings.site.title %}
{% set pageDescription = description or settings.site.description %}
{% set pageCanonical = page.url | absoluteUrl(settings.site.url) %}
{% if image %}
    {% set pageImage = image | absoluteUrl(settings.site.url) %}
{% else %}
    {% set pageImage = settings.site.url + "images/logo/logo.png" %}
{% endif %}
{% set currentPageType = pageType or "website" %}
<!DOCTYPE html>
<html lang="{{ settings.site.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    
    <!-- SEO Meta Tags -->
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <meta name="keywords" content="{{ settings.site.keywords }}">
    <meta name="author" content="{{ settings.site.author }}">
    <meta name="robots" content="index, follow">
    <meta name="language" content="Russian">
    <meta name="format-detection" content="telephone=yes">
    
    <!-- Geographic Tags -->
    <meta name="geo.region" content="MD-GA">
    <meta name="geo.placename" content="Комрат, Молдова">
    <meta name="geo.position" content="{{ settings.contact.coordinates.latitude }};{{ settings.contact.coordinates.longitude }}">
    <meta name="ICBM" content="{{ settings.contact.coordinates.latitude }}, {{ settings.contact.coordinates.longitude }}">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="{{ currentPageType }}">
    <meta property="og:url" content="{{ pageCanonical }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:image" content="{{ pageImage }}">
    <meta property="og:image:alt" content="{{ pageTitle }}">
    <meta property="og:site_name" content="{{ settings.site.name }}">
    <meta property="og:locale" content="ru_RU">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ pageCanonical }}">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ pageImage }}">
    
    <!-- Mobile App Meta Tags -->
    <meta name="theme-color" content="{{ settings.site.themeColor }}">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="NeuroDeny">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="{{ '/images/logo/logo.png' | url }}">
    <link rel="apple-touch-icon" href="{{ '/images/logo/logo.png' | url }}">
    <link rel="canonical" href="{{ pageCanonical }}">
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="{{ '/css/reset.css' | url }}?v={{ assetVersion }}">
    <link rel="stylesheet" href="{{ '/css/style.css' | url }}?v={{ assetVersion }}">
    <!-- Tailwind CSS (migration) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#255282',
                        secondary: '#0694CB',
                    }
                }
            },
            corePlugins: { preflight: false }
        }
    </script>
    
    <!-- Schema.org structured data -->
    <script type="application/ld+json">
    [
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "{{ settings.site.url }}#website",
        "url": "{{ settings.site.url }}",
        "name": "{{ settings.site.name }}",
        "description": "{{ settings.site.description }}",
        "inLanguage": "ru",
        "publisher": { "@id": "{{ settings.site.url }}#clinic" }
      },
      {
        "@context": "https://schema.org",
        "@type": "MedicalClinic",
        "@id": "{{ settings.site.url }}#clinic",
        "name": "{{ settings.site.name }}",
        "image": "{{ settings.site.url }}images/logo/logo.png",
        "logo": "{{ settings.site.url }}images/logo/logo.png",
        "description": "{{ settings.site.description }}",
        "url": "{{ settings.site.url }}",
        "telephone": "{{ settings.contact.phone | replace(' ', '') }}",
        "email": "{{ settings.contact.email }}",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "{{ settings.contact.address.street }}",
          "addressLocality": "{{ settings.contact.address.city }}",
          "postalCode": "{{ settings.contact.address.postalCode }}",
          "addressCountry": "MD"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": {{ settings.contact.coordinates.latitude }},
          "longitude": {{ settings.contact.coordinates.longitude }}
        },
        "hasMap": "https://www.google.com/maps/search/?api=1&query={{ settings.contact.coordinates.latitude }},{{ settings.contact.coordinates.longitude }}",
        "areaServed": ["Комрат", "Гагаузия", "Молдова"],
        "medicalSpecialty": ["Neurology", "Pediatric Neurology", "Surgery"],
        "availableService": {{ services.services | serviceSchema | safe }},
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "09:00",
            "closes": "15:30"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": "Saturday",
            "opens": "09:00",
            "closes": "14:00"
          }
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5.0",
          "reviewCount": "{{ reviews.reviews | visibleReviewCount }}"
        }
      }
    ]
    </script>

    {% if page.url == "/" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for item in faqs.items %}
        {
          "@type": "Question",
          "name": {{ item.question | json | safe }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ item.answer | json | safe }}
          }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
    </script>
    {% endif %}
</head>
<body>
    {% include "mascot.njk" %}
    {% include "navigation.njk" %}
    
    {{ content | safe }}
    
    {% include "footer.njk" %}
    {% include "scripts.njk" %}
</body>
</html>
