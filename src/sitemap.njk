---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in collections.sitemapPages %}
  <url>
    <loc>{{ item.url | absoluteUrl(settings.site.url) }}</loc>
    <lastmod>{{ item.date | htmlDateString }}</lastmod>
    <changefreq>{% if item.url == "/" %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if item.url == "/" %}1.0{% elif item.url.includes('/blog/') %}0.7{% else %}0.8{% endif %}</priority>
  </url>
{% endfor %}
</urlset>
